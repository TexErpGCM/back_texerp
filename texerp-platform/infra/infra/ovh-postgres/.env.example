# Copia este archivo como .env y reemplaza todos los valores CHANGE_ME.
# No uses comillas, espacios alrededor de "=" ni saltos de linea en secretos.

# Acceso SSH al VPS OVHcloud
VPS_HOST=CHANGE_ME_PUBLIC_IP_OR_DNS
VPS_SSH_PORT=22
VPS_SSH_USER=ubuntu
VPS_SSH_KEY_PATH=CHANGE_ME_ABSOLUTE_PATH_TO_PRIVATE_KEY
# Si se deja vacio, OpenSSH solicitara la contrasena de forma interactiva.
# El script no automatiza contrasenas SSH ni las pasa en la linea de comandos.
VPS_SSH_PASSWORD=

# PostgreSQL
POSTGRES_PORT=5432
POSTGRES_DB=texerp
POSTGRES_APP_USER=texerp_app
POSTGRES_APP_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Nombre DNS o IP que usaran los clientes. Se incluye en el certificado TLS.
POSTGRES_TLS_HOSTNAME=CHANGE_ME_PUBLIC_IP_OR_DNS

# Acceso publico solicitado. Para restringirlo, usa CIDR separados por coma,
# por ejemplo: 203.0.113.10/32,198.51.100.0/24
POSTGRES_ALLOWED_CIDRS=0.0.0.0/0,::/0

# Activa UFW conservando primero el acceso al puerto SSH indicado arriba.
ENABLE_UFW=true

# Limites de recursos. 0 deja que el instalador calcule valores a partir de
# RAM/vCPU reales, sin exceder 60 % de RAM ni 75 % de CPU para PostgreSQL.
# Un valor explicito solo puede ser menor que el limite automatico seguro.
POSTGRES_MEMORY_MAX_MIB=0
POSTGRES_CPU_QUOTA_PERCENT=0
POSTGRES_MAX_CONNECTIONS=0
POSTGRES_APP_CONNECTION_LIMIT=0
POSTGRES_WORK_MEM_MIB=0
POSTGRES_STATEMENT_TIMEOUT_MS=60000
POSTGRES_TEMP_FILE_LIMIT_MIB=512

# Variables listas para Spring Boot y clientes PostgreSQL.
SPRING_DATASOURCE_URL=jdbc:postgresql://CHANGE_ME_PUBLIC_IP_OR_DNS:5432/texerp?sslmode=verify-full
SPRING_DATASOURCE_USERNAME=texerp_app
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://texerp_app:CHANGE_ME_URL_ENCODED_PASSWORD@CHANGE_ME_PUBLIC_IP_OR_DNS:5432/texerp?sslmode=verify-full
